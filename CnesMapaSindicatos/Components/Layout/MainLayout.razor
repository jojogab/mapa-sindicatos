@inherits LayoutComponentBase

<div style="min-height: 100vh; width: 100vw; overflow: hidden; background-color: var(--bg-primary); color: var(--text-primary);">
    @Body
</div>

<div id="blazor-error-ui" style="display:none;">
    <span>Ocorreu um erro na aplicação. Recarregue a página para reconectar.</span>
    <a href="" class="reload">Recarregar</a>
    <button type="button" class="dismiss" aria-label="Dispensar aviso">×</button>
</div>